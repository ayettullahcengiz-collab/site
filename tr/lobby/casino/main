<script>
    let settings = {
        language: 'tr',
        userId: '0',
        trns: {
            Play: 'Oyna',
            Demo: 'Demo Oyun',
            NoSearchResults: 'Sonu&#231; Bulunamadı',
            YouHaveNoFavoriteGames: 'Hen&#252;z herhangi bir oyunu favorilerinize eklemediniz.',
            ToAddFavGames: 'Bir oyunu favorilerinize eklemek i&#231;in, oyun g&#246;rselinin sağ &#252;st k&#246;şesinde bulunan yıldıza tıklayabilirsiniz.',
            NoSuchGameFound: 'Oyun bulunamadı',
            YouHaveNoLastPlayedGames: 'Son oynadığınız bir oyun bulunamadı.',
        },
        isMobileVerified: 'False',
        isDocumentVerified: 'False',
        cdnUrl: '//cdn.grandpashabet9090.com/plat/prd/',
        RmCdnUrl: 'https://apir.revnix.click/plat/prd/',
        currencyCode: 'TRY',
        partnerId: '1093',
        favoriteGroupType: '2',
        hasStaticLoginPage: JSON.parse('false'),
        lastPlayedGroupType: '7',
        lobbyGridType: '2',
        lobbyName: 'casino',
        lobbyPreviewType: '2',
        gameCardType: '0'
    };
    GamesCommon.init(settings);

    let data = {
        trns: {
            UseLatinLettersInSearch: 'Arama kısmında yalnızca harfler, numaralar ve semboller (&#171;։&#187;, &#171;™&#187;, &#171;&quot;&#187;.) kullanabilirsiniz.',
            SuggestedGames: '&#214;nerilen Oyunlar'
        },
        lobbyUrl: 'casino',
        slider: '',
        catViewType: '1',
        isMobileBrowser: false,
        isMobileDevice: JSON.parse('false'),
        languageDirection: typeof rtlLng != 'undefined' ? "rtl" : 'ltr',
        isFixedHeader: document.documentElement.dataset.stickyHeader === 'True',
        closedPrvList: JSON.parse('false')
    };
    data.slider = new Swiper('#js_lobby_group_slider', {
        slidesPerView: 'auto',
        spaceBetween: 48,
        navigation: {
            prevEl: '#js_lobby_group_slider_prev',
            nextEl: '#js_lobby_group_slider_next',
        },
        on: {
            init: function (swiper) {
                if (swiper.isBeginning) {
                    $(swiper.el).addClass('sw_beginning');
                }
                if (swiper.isEnd) {
                    $(swiper.el).addClass('sw_end');
                }
            },
            transitionStart: function (swiper) {
                $(swiper.el).removeClass('sw_beginning sw_end');
                if (swiper.isBeginning) {
                    $(swiper.el).addClass('sw_beginning');
                }
                if (swiper.isEnd) {
                    $(swiper.el).addClass('sw_end');
                }
            },
            resize: function (swiper) {
                $(swiper.el).removeClass('sw_beginning sw_end');
                if (swiper.isBeginning) {
                    $(swiper.el).addClass('sw_beginning');
                }
                if (swiper.isEnd) {
                    $(swiper.el).addClass('sw_end');
                }
            }
        },
    });
    Lobbies.init(data);

    var allowChange = true;
    $('.js_jackpot_types').on('click', function () {
        let jcType = $(this);
        if ($(jcType).hasClass('active')) {
            return;
        }
        $('.js_jackpot_types').removeClass('active');
        $(jcType).addClass('active');
        if (allowChange) {
            allowChange = false;
            let jpType = this.dataset.jpType;
            let url = this.dataset.url;
            let contNode = document.getElementById('jackpot_container_lobby');
            if (contNode.firstElementChild && typeof contNode.firstElementChild.Jackpot != 'undefined') {
                contNode.firstElementChild.Jackpot.destroy();
            }
            skeletOn('jackpot', 4, '#jackpot_container_lobby');
            GetJackpotView(jpType, url);
        }
    });

    function GetJackpotView(jpType, url) {
        $.ajax({
            type: "GET",
            data: { jt: jpType, url: url },
            url: "/Home/GetJackpotView",
            success: function (result) {
                allowChange = true;
                $('#jackpot_container_lobby').html(result);
            }
        });
    }

    $(document).ready(function () {
        let firstJack = document.querySelector('.js_jackpot_types');
        if (firstJack) {
            GetJackpotView(firstJack.dataset.jpType, firstJack.dataset.url);
        }
