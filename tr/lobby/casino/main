        <script>
        window.AppTrackers.gtm = function () {
            var deviceTypeAdd = window.dataLayer;
            (function (w, d, s, l, i) {
                w[l] = w[l] || [];
                !deviceTypeAdd ? w[l].push({ 'deviceType': 'web' }) : null;
                w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
                var f = d.getElementsByTagName(s)[0],
                    j = d.createElement(s),
                    dl = l != 'dataLayer' ? '&l=' + l : '';
                j.async = true;
                j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
                f.parentNode.insertBefore(j, f);
            })(window, document, 'script', 'dataLayer', 'GTM-5MXXS2BH');
        };
        </script>
    <script>
        (function () {
            'use strict';
            var executed = false;
            function runAllTrackers() {
                if (executed) return;
                executed = true;
                cleanupTriggers();
                for (var key in window.AppTrackers) {
                    if (typeof window.AppTrackers[key] === 'function') {
                        try {
                            window.AppTrackers[key]();
                        } catch (e) {
                            console.error('Error executing tracker:', key, e);
                        }
                    }
                }
            }

            function cleanupTriggers() {
                window.removeEventListener('pointerdown', runAllTrackers, { passive: true });
                window.removeEventListener('keydown', runAllTrackers, { passive: true });
                window.removeEventListener('scroll', runAllTrackers, { passive: true });
                window.removeEventListener('touchstart', runAllTrackers, { passive: true });
                if (window.idleTimer) clearTimeout(window.idleTimer);
            }

            window.addEventListener('pointerdown', runAllTrackers, { passive: true });
            window.addEventListener('keydown', runAllTrackers, { passive: true });
            window.addEventListener('scroll', runAllTrackers, { passive: true });
            window.addEventListener('touchstart', runAllTrackers, { passive: true });
            if ('requestIdleCallback' in window) {
                requestIdleCallback(function () {
                    window.idleTimer = setTimeout(runAllTrackers, 3000);
                }, { timeout: 5000 });
            } else {
                window.idleTimer = setTimeout(runAllTrackers, 4000);
            }
        })();
    </script>








