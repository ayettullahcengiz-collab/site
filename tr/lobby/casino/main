<script type="text/javascript">
    setActiveClassToPrMenuItems('js_menu_links');

    $(document).on('click', '.js_open_dropdown', function (e) {
        e.stopPropagation();
        e.preventDefault();
        let dropDownCont = $(this).parents('.js_header_dropdown');
        if (dropDownCont.hasClass('open')) {
            dropDownCont.removeClass('open');
        } else {
            $('.js_header_dropdown').removeClass('open');
            dropDownCont.addClass('open');
        }
    });

    window.addEventListener("hashchange", function (event) {
        setActiveClassToPrMenuItems('js_menu_links');
    });

    $(document).on('click', function () {
        $('.js_header_dropdown').removeClass('open');
    });
</script> 
<script type="text/javascript">
    let box = document.querySelector(".header_dropdown");

    function headerDropdownOpen() {
        box.classList.toggle("active_header_content");
    }
</script>            <script type="text/javascript">
            function respHdr() {
                let navigationContainer = document.querySelector(".tl_header_bot_row_fix");
                let navigation = document.querySelector(".tl_header_navigation");
                if (!navigationContainer || !navigation) return;

                if (document.getElementById('js_dy_hdr_more')) {
                    if (typeof window.__respHdrRecalc === 'function') {
                        window.__respHdrRecalc();
                    }
                    return;
                }

                let navigationsArray = Array.from(navigation.children);

                function measureItemWidth(item) {
                    let style = window.getComputedStyle(item);
                    let marginLeft = parseFloat(style.marginLeft) || 0;
                    let marginRight = parseFloat(style.marginRight) || 0;
                    return item.getBoundingClientRect().width + marginLeft + marginRight;
                }

                let navItemsWidths = navigationsArray.map(measureItemWidth);

                function refreshItemWidths() {
                    navigationsArray.forEach((item, index) => {
                        if (item.parentNode === navigation) {
                            navItemsWidths[index] = measureItemWidth(item);
                        }
                    });
                }

                let navigationContainerMoreBtn = document.createElement("div");
                navigationContainerMoreBtn.className = "header_nav__more";
                navigationContainerMoreBtn.id = "js_dy_hdr_more";
                navigationContainerMoreBtn.innerHTML = "<span class='header_more_btn'>Daha Fazlası</span>";

                let navigationContainerMore = document.createElement("div");
                navigationContainerMore.className = "header_nav__more_content";
                navigationContainerMore.id = "js_dy_hdr_more_content";

                navigationContainerMoreBtn.appendChild(navigationContainerMore);
                navigationContainer.appendChild(navigationContainerMoreBtn);

                let isAMnType = 'False'.toLowerCase() === 'true';

                function rearrangeNavigationItems() {

                    let hdrCont = document.getElementById('js_dy_hdr_cont');
                    let sportSw = document.getElementById('SportView');

                    let hdrContLeft = hdrCont ? hdrCont.offsetLeft : 0;
                    let sportSwWidth = sportSw ? sportSw.offsetWidth : 0;
                    let hdrMoreBtnWidth = navigationContainerMoreBtn.offsetWidth;
                    let hdrMoreContentWidth = navigationContainerMore.offsetWidth;

                    let moreSize = Math.max(hdrMoreBtnWidth, hdrMoreContentWidth);
                    let winWid = isAMnType ? 800 - moreSize : window.innerWidth - (hdrContLeft * 2) - sportSwWidth - moreSize - 15;

                    let visWidth = 0;
                    let fitCount = navigationsArray.length;

                    for (let i = 0; i < navItemsWidths.length; i++) {
                        if (visWidth + navItemsWidths[i] > winWid) {
                            fitCount = i;
                            break;
                        }
                        visWidth += navItemsWidths[i];
                    }

                    let allVisible = fitCount === navigationsArray.length;

                    navigationContainerMoreBtn.style.visibility = allVisible ? "hidden" : "";

                    let navFragment = document.createDocumentFragment();
                    let moreFragment = document.createDocumentFragment();

                    navigationsArray.forEach((item, index) => {
                        if (index < fitCount) {
                            item.classList.remove('bg-tert');
                            navFragment.appendChild(item);
                        } else {
                            item.classList.add('bg-tert');
                            moreFragment.appendChild(item);
                        }
                    });

                    navigation.appendChild(navFragment);
                    navigationContainerMore.appendChild(moreFragment);

                    let hasActiveInMore = navigationContainerMore.querySelector(".tl_main_nav_item-active") !== null;
                    let moreBtnSpan = navigationContainerMoreBtn.querySelector(".header_more_btn");
                    if (moreBtnSpan) {
                        moreBtnSpan.classList.toggle("text-primary", hasActiveInMore);
                    }
                }

                window.__respHdrRecalc = function () {
                    refreshItemWidths();
                    rearrangeNavigationItems();
                };

                if (!isAMnType) {
                    let resizeTicking = false;
                    function onResize() {
                        if (!resizeTicking) {
                            window.requestAnimationFrame(() => {
                                rearrangeNavigationItems();
                                resizeTicking = false;
                            });
                            resizeTicking = true;
                        }
                    }
                    if (window.__respHdrResizeHandler) {
                        window.removeEventListener("resize", window.__respHdrResizeHandler);
                    }
                    window.__respHdrResizeHandler = onResize;
                    window.addEventListener("resize", onResize);

                    if (document.fonts && document.fonts.ready) {
                        document.fonts.ready.then(function () {
                            window.__respHdrRecalc();
                        });
                    }
                }
                rearrangeNavigationItems();
            }

            if ('False'.toLowerCase() !== 'true' && document.getElementById('js_dy_hdr')) {
                setTimeout(function () {
                    respHdr();
                    $('#js_dy_hdr, #js_dy_hdr_more').removeClass('hdr_effect');
                }, 300);
            }
            </script>
        
