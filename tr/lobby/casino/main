        $(document).on("click", '.links_container.profile:not(#logout)', function (e) {
            tabClicked = false;
        });
        $(document).on('click', 'a.tl_my_acc_nav_item', function(e) {
            e.preventDefault();
            if (!$(this).hasClass('active')) {

                if ($(this).attr('id') == 'deposit_tab') {
                    if ('True'.toLocaleLowerCase() == 'true') {
                        openBonusRequestPopup('True'.toLocaleLowerCase() == 'false', true);
                    }
                    if ('True'.toLocaleLowerCase() == 'true') {
                        return;
                    }
                }
                if ($(this).attr('id') == 'withdraw_tab' && 'True'.toLocaleLowerCase() == 'true') {
                    $(this).closest(".ui-dialog-content").dialog("close");
                    openCashierPopup(2);
                    return;
                }

                if (tabClicked) {
                    return false;
                }

                tabClicked = true;

                var tabUrl = $(this).data("href");
                var tabId = this.id;
                if (tabId == 'notification_tab') {
                     getCss('//cdn.grandpashabet9090.com/plat/prd/CW/GGP' + '/Content/components/notificationSettings.css?v=' + '1.1711.2026.1015');
                }
                if ('False'.toLocaleLowerCase() == 'true' && '' == 'yes' && tabId == 'deposit_tab') {
                    tabClicked = false;
                    return false;
                }
                if ('1093' == '1201' && (tabId == 'deposit_tab' || tabId == 'withdraw_tab')) {
                    checkClientStatus(true, tabId, tabUrl);
                    tabClicked = false;
                } else if (typeof cw_fillInFLname != 'undefined' && cw_fillInFLname == true && tabId == 'deposit_tab') {
                    $(this).closest(".ui-dialog-content").remove();
                    tabClicked = false;
                    click = 0;
                    showpopup = true;
                    FillInFnameLname();
                } else if ('False' == 'True' && tabId == 'deposit_tab') {
                    loadTab('profile_tab', '/Account/profile', function () {
                        tabClicked = false;
                        activateTab('profile_tab');
                    });
                } else {
                    loadTab(tabId, tabUrl, function () {
                        tabClicked = false;
                        activateTab(tabId);
                    });
                }
            }
        });

        /* Inbox */
        $(".inboxDialog").on("click", function (e) {
            e.preventDefault();
            var url = $(this).data("href");
             getCss('//cdn.grandpashabet9090.com/plat/prd/CW/GGP' + '/Content/components/popups/inbox_v2.css?v=' + '1.1711.2026.1015').then(function () {
