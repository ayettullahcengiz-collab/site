                        $(this).load(url, function (data) {

                            // check if is user is not logged, redirect
                            if (!isLogged(data)) {
                                location.href = "/";
                                return false;
                            }

                            hideSpinner();
                        });
                    }
                });

                $(window).on('resize', function () {
                    $("#inboxContent").dialog("option", "position", { my: "center", at: "center", of: window });
                });

            });
        });
        /* Inbox End */


