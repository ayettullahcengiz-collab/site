    function showPopup(pageUrl, containerId, popupOptions, callback) {
        if (pageUrl.toLowerCase().includes('/login/login') && typeof showLoginRestrictedMessage == 'function') {
            showLoginRestrictedMessage();
            click = 0;
            return;
        }
        if (pageUrl.toLowerCase().includes('/registration/register') && typeof showRegistrationRestrictedMessage == 'function') {
            showRegistrationRestrictedMessage();
            click = 0;
            return;
