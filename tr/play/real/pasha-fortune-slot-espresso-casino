    function showPopup(pageUrl, containerId, popupOptions, callback) {
        if (pageUrl.toLowerCase().includes('/login/login') && typeof showLoginRestrictedMessage == 'function') {
            showLoginRestrictedMessage();
            click = 0;
            return;
        }
        if (pageUrl.toLowerCase().includes('/registration/register') && typeof showRegistrationRestrictedMessage == 'function') {
            showRegistrationRestrictedMessage();
            click = 0;
            return;
        }

        var passChangeRequired = 'false';
        if (passChangeRequired == 'true' && containerId != 'forceChangePassContent') {
            showPopup('/account/forcechangepassword', 'forceChangePassContent', {
                position: null,
                dialogClass: 'tl_popup_dialog js_popup_dialog flex_popup_content',
                responsive: false,
            });
            return;
        }
        if ('False'.toLocaleLowerCase() == 'false') {
            $('body').addClass('ofh');
        }
        $(window).scrollTop(0);
        callback = callback || false;

        // setting options
        var options = popupOptions || {};

        // setting dialog options
        var dialogOptions = {

            clickOut: false,
            showTitleBar: false,
            showCloseButton: false,
            responsive: true,
            dialogClass: "tl_popup_dialog",
            modal: true,
            draggable: false,
            resizable: false,
            closeOnEscape:true,
            show: {
                effect: "fadeIn",
                duration: 300
            },
            hide: {
                effect: "fadeOut",
                duration: 300
            },
            position: {},
            open: function(e, ui) {
                $(this).load(pageUrl, function (responseText, textStatus, jqXHR) {
                    if (pageUrl?.toLowerCase().includes('/login/login') && jqXHR.getResponseHeader('cf-mitigated') === 'challenge') {
                        location.href = '/login/login';
                    }
                    hideSpinner();
                });
            },
            close: function() {
                $(this).remove();
                if (!$('body').hasClass('no_scroll')) {
                    $('body').removeClass('ofh');
                }
                $('body').removeClass('bodyscroll');
                if ('False'.toLowerCase() == 'true')
                {
                    if (containerId == "inboxContent") {
                        var url = window.location.href;
                        if (url.includes('/?account=1')) {
                            url = url.replace('/?account=1', '');
                            window.location.href = url;
                        }
                    }
                }

            }
        };

        dialogOptions = $.extend(dialogOptions, options);

        if (containerId == 'forceChangePassContent' || containerId == 'selfExclusionContent' || containerId == 'changeLoginPassContent') {
            dialogOptions = $.extend(dialogOptions, { closeOnEscape:false});
        }

        if (containerId == 'registerContent' && 'False'.toLowerCase() == 'true' || 'False'.toLowerCase() == 'true') {
            dialogOptions = $.extend(dialogOptions, { closeOnEscape: false });
        }

        showSpinner();

        if (!callback) {
            $('<div />', {
                    id: containerId,
                    class: 'dialog'
                })
                .appendTo("body").dialog(dialogOptions);
        } else {
            callback(dialogOptions);
        }
        if (dialogOptions.position == null) {
            $('.js_popup_dialog').removeAttr('style');
            $('#registerContent').removeAttr('style');
            $('#loginContent').removeAttr('style');
        }
    }

